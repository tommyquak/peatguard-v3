# PeatGuard Dashboard Container
# Lightweight image for serving the COG visualization dashboard.
# Does NOT include ISCE2, MintPy, or any processing dependencies.

FROM python:3.10-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    libgdal-dev \
    && rm -rf /var/lib/apt/lists/*

# Install dashboard dependencies only
RUN pip install --no-cache-dir \
    "fastapi>=0.109.0" \
    "uvicorn[standard]>=0.27.0" \
    "titiler.core>=0.18.0" \
    "jinja2>=3.1.0" \
    "rasterio>=1.3.0" \
    "pydantic>=2.5.0" \
    "pyyaml>=6.0"

COPY . /app
WORKDIR /app
RUN pip install --no-cache-dir .

EXPOSE 8080

CMD ["uvicorn", "peatguard.dashboard.app:app", "--host", "0.0.0.0", "--port", "8080"]
